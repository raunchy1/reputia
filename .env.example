# Database (in Docker Compose l'URL viene costruito da POSTGRES_*)
DATABASE_URL="postgresql://reputia:replace_me@127.0.0.1:5433/reputia?schema=public"
POSTGRES_USER=reputia
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_SECRET
POSTGRES_DB=reputia

# URL pubblico dell'app, senza slash finale
APP_URL=http://localhost:3000
APP_PORT=3000
