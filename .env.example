# ─── Database ──────────────────────────────────────────────────────────────
# In Docker Compose DATABASE_URL is built from POSTGRES_*; set it only for local dev.
DATABASE_URL="postgresql://reputia:replace_me@127.0.0.1:5433/reputia?schema=public"
POSTGRES_USER=reputia
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_SECRET
POSTGRES_DB=reputia

# ─── App ───────────────────────────────────────────────────────────────────
# Public URL, no trailing slash. Used for auth callbacks and email links.
APP_URL=http://localhost:3000
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# 32 random bytes, base64: openssl rand -base64 32 — encrypts Google tokens. Never change it after go-live.
ENCRYPTION_KEY=

# ─── Email (required in production) ────────────────────────────────────────
# e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
EMAIL_FROM="Reputia <noreply@example.com>"
# Where new demo requests are notified
LEADS_NOTIFY_EMAIL=

# ─── AI ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ─── Google Business Profile (needs an approved GBP API project) ───────────
# OAuth redirect URI to register in Google Cloud: ${APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Marketing / legal ─────────────────────────────────────────────────────
NEXT_PUBLIC_PLAN_PRICE_EUR=19
NEXT_PUBLIC_TRIAL_DAYS=14
DEMO_BOOKING_URL=
LEGAL_COMPANY_NAME=
LEGAL_VAT_NUMBER=
LEGAL_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_PEC=
